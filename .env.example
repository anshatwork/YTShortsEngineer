# Copy to .env and fill in. NEVER commit real secrets — .env is gitignored.

# ─── Supabase (required for persistent stores + auth) ────────────────────────
# Create a project at https://supabase.com, then copy values from
# Project Settings → API. Run the SQL in supabase/migrations/*.sql once.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Store backends. Each defaults to "supabase" when SUPABASE_URL is set, else
# "memory" (in-process, lost on restart — for local dev / tests). Force with:
#   JOB_STORE / SUBSCRIPTION_STORE / CREDIT_STORE = memory | supabase
JOB_STORE=supabase
SUBSCRIPTION_STORE=supabase
CREDIT_STORE=supabase

# Set true to skip JWT verification in local dev (no Supabase Auth needed).
AUTH_DISABLED=false

# CORS + checkout return URLs: comma-separated allowed frontend origins.
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# ─── Billing: subscription quota (coarse monthly job cap, secondary guard) ───
# Enforced only when SUPABASE_URL is set and QUOTA_ENABLED is not false.
QUOTA_ENABLED=true
PLAN_FREE_MONTHLY_JOBS=3
PLAN_PRO_MONTHLY_JOBS=100
PLAN_BUSINESS_MONTHLY_JOBS=1000

# ─── Billing: credits (primary per-operation meter) ──────────────────────────
# Opt-in: credits are enforced only when CREDITS_ENABLED is true. Each plan
# grants a monthly allowance; every metered operation debits its cost. Running
# out returns HTTP 402. Balances live in the append-only credit_ledger table
# (supabase/migrations/009_credits.sql).
CREDITS_ENABLED=true
CREDITS_GRANT_FREE=30
CREDITS_GRANT_PRO=1000
CREDITS_GRANT_BUSINESS=10000
CREDITS_COST_CLIP=10
CREDITS_COST_TTS=2
CREDITS_COST_MUSIC=2
CREDITS_COST_SPLIT=3
CREDITS_COST_THUMBNAIL=1
CREDITS_COST_INGEST=5

# ─── Payments: Stripe (international) ─────────────────────────────────────────
# Dashboard → Developers → API keys / Webhooks. Prices are recurring Price ids.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
STRIPE_PRICE_PRO=price_your_pro_price_id
STRIPE_PRICE_BUSINESS=price_your_business_price_id

# ─── Payments: Razorpay (India) ──────────────────────────────────────────────
# Dashboard → Settings → API Keys / Webhooks. Plans are subscription Plan ids.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_PLAN_PRO=plan_your_pro_plan_id
RAZORPAY_PLAN_BUSINESS=plan_your_business_plan_id

# ─── YouTube Shorts pipeline ─────────────────────────────────────────────────
YT_API_KEY=your_youtube_data_api_key

# ─── LLM provider: claude (default) | ollama | hf | glm ──────────────────────
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6
ENABLE_LLM_FALLBACK=false
# Hard kill-switch: force EVERY LLM call onto the local Ollama model, ignoring
# LLM_PROVIDER and any per-user BYOK key — no request can reach a hosted provider
# (Claude/GLM/HF). Leave false for normal provider/BYOK routing; set true for a
# fully local, no-API deployment.
LLM_LOCAL_ONLY=false
# Ollama (local fallback). Use 127.0.0.1, not localhost (IPv6 issue on Windows).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# GLM via OpenRouter (OpenAI-compatible).
GLM_API_KEY=your_glm_or_openrouter_key
GLM_BASE_URL=https://openrouter.ai/api/v1
GLM_MODEL=z-ai/glm-4.5-air

# ─── Inference scheduler (single choke point for all LLM calls) ──────────────
# Keep concurrency at 1 on a single-GPU Ollama box to avoid VRAM thrash.
INFERENCE_SCHEDULER_ENABLED=true
INFERENCE_MAX_CONCURRENCY=1
INFERENCE_QUEUE_MAXSIZE=256
INFERENCE_MAX_RETRIES=2
# Local model tiers — the scheduler routes each task class to the smallest
# sufficient model. Leave unset to use OLLAMA_MODEL for every tier.
INFERENCE_MODEL_SMALL=qwen2.5:3b
INFERENCE_MODEL_MEDIUM=qwen2.5:7b-instruct
INFERENCE_MODEL_LARGE=qwen2.5:14b-instruct
# Phase 2 single-GPU model management (Ollama only): warm the eval-tier model on
# startup and unload it after INFERENCE_IDLE_TIMEOUT_S idle to free VRAM.
INFERENCE_WARM_ENABLED=false
INFERENCE_IDLE_TIMEOUT_S=300
INFERENCE_WARM_KEEPALIVE=10m

# ─── Autonomous Publishing Agent ─────────────────────────────────────────────
PUBLISH_DISCOVER_TOP_N=5
PUBLISH_SCORE_KEEP=3
PUBLISH_MAX_REVISIONS=2
EVAL_PASS_THRESHOLD=70
EVAL_MIN_DIMENSION=3
CREDITS_COST_PUBLISH=10

# ─── YouTube Data API quota governance ───────────────────────────────────────
# search.list costs 100 units; the default project budget is 10000 units/day and
# resets at midnight US-Pacific. The trending crawler and interactive discovery
# share this budget (tools/youtube/quota.py).
YOUTUBE_DAILY_QUOTA=10000
# Units held back for interactive discovery; the background trending crawler
# skips a cycle when remaining drops below this.
YT_QUOTA_RESERVE=2000
# TTL for the in-process search cache — a repeat query within the window costs 0 units.
YT_SEARCH_CACHE_TTL_HOURS=6
# Retries for transient rate-limit / 5xx errors (daily-quota is never retried).
YT_MAX_RETRIES=3
YT_BACKOFF_BASE_SECONDS=1.0
# Background trending crawler cadence + how many topics it refreshes per cycle
# (rotating), keeping per-crawl quota spend low.
TRENDING_CRAWLER_HOURS=12
TRENDING_CRAWLER_TOPICS_PER_CYCLE=3

# ─── YouTube direct-upload OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/youtube/auth/callback

# ─── TTS / media ─────────────────────────────────────────────────────────────
HUGGINGFACE_API_KEY=your_huggingface_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OUTPUT_DIR=./output
BACKGROUND_VIDEO_PATH=./assets/background.mp4
VIDEO_LIBRARY_PATH=./assets/video_library

# ─── Audio APIs (background music) ───────────────────────────────────────────
PIXABAY_API_KEY=your_pixabay_api_key
FREESOUND_API_KEY=your_freesound_api_key
JAMENDO_CLIENT_ID=your_jamendo_client_id
AUDIO_CACHE_MAX_SIZE_MB=500
# Background music warmer cadence + how many tracks to keep warm per theme.
MUSIC_CACHE_REFRESH_HOURS=24
MUSIC_CACHE_TRACKS_PER_THEME=8
# Asset-download resilience: retry transient 429/5xx, then negative-cache a
# persistently broken track (e.g. a Jamendo storage 500) so it's skipped for
# ASSET_NEGATIVE_CACHE_TTL_HOURS instead of retried every refresh cycle.
ASSET_MAX_RETRIES=2
ASSET_BACKOFF_BASE_SECONDS=0.5
ASSET_NEGATIVE_CACHE_TTL_HOURS=6

# ─── Knowledge Graph (core/kg) — Neo4j/Memgraph sidecar ──────────────────────
# Persistent multimodal knowledge graph. Additive + off by default: set
# KG_ENABLED=true and point NEO4J_URI at a Neo4j 5.13+ (or Memgraph) bolt
# endpoint. Apply the schema once with:  python -m core.kg.migrations
KG_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please_change_me
# NEO4J_DATABASE=neo4j
KG_VECTOR_SIMILARITY=cosine

# ─── Embeddings (tools/embeddings) — local-default + hash fallback ───────────
# EMBEDDING_PROVIDER: local (sentence-transformers + OpenCLIP) | hash (deps-free,
# deterministic — used automatically if local deps are missing when FALLBACK=1).
# DIMs MUST match the model AND the Neo4j vector indexes (re-run migrations if
# you change a model/dim).
EMBEDDING_PROVIDER=local
EMBEDDING_FALLBACK=true
EMBEDDING_MODEL_TEXT=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_IMAGE=ViT-B-32:laion2b_s34b_b79k
EMBEDDING_DIM_TEXT=384
EMBEDDING_DIM_IMAGE=512

# Caddy reverse proxy — terminates TLS (auto Let's Encrypt) and forwards to the
# API container. {$DOMAIN} / {$ACME_EMAIL} are read from the environment (set in
# .env, passed through docker-compose).
#
# This fronts ONLY the backend API. The Next.js frontend is hosted separately
# (Cloudflare Pages / Amplify) and calls this domain as NEXT_PUBLIC_API_URL.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Streaming endpoints — disable proxy buffering so bytes flush immediately
	# and connections stay long-lived. Covers SSE progress streams and the MCP
	# connector's Streamable-HTTP transport (Claude.ai / ChatGPT).
	@stream path /api/v1/events* /api/v1/*/events* /mcp*
	reverse_proxy @stream api:8000 {
		flush_interval -1
	}

	# Everything else (REST API, /mcp OAuth discovery + tool calls, static
	# artifacts) is a normal proxied request to the single API process.
	reverse_proxy api:8000

	# Don't leak the server banner.
	header -Server

	log {
		output stdout
		format console
	}
}

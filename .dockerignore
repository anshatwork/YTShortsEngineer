# Keep the build context small and secrets out of the image.
.git
.gitignore
.env
.env.*
*.env
frontend/.env.local

# Frontend is built/hosted separately (Cloudflare Pages / Amplify).
frontend/node_modules
frontend/.next
node_modules

# Local data / artifacts — never bake into the image.
output/
cache/
/cache/
logs/
assets/audio_cache/
*.mp4
*.mp3
*.wav

# Python caches / venvs
__pycache__/
*.pyc
.venv/
venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Agent / editor tooling
.claude/
.cursor/
.codegraph/
.vscode/
.idea/

# Plans / docs scratch
*.bak
*.tmp
